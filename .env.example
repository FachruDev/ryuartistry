# Database (Neon Postgres)
DATABASE_URL=

# Storage (Neon Object Storage, S3-compatible)
# Buckets: assets-public (public_read), assets-private
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Auth (generate the secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Optional on Vercel: both fall back to the project's production domain.
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# First admin account (used by bun run db:seed)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare Turnstile ("saya bukan robot") on the contact form. Leave empty to turn it off.
# Get keys at dash.cloudflare.com -> Turnstile -> Add widget (domain: your site + localhost).
# Local testing: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA always pass.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
