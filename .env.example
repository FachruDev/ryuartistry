# Database (Neon Postgres)
DATABASE_URL=

# Storage (Neon Object Storage, S3-compatible)
# Buckets: assets-public (public_read), assets-private
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Auth (generate the secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# First admin account (used by bun run db:seed)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
