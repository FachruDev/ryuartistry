# Database (Neon Postgres)
DATABASE_URL=

# Storage (Neon Object Storage, S3-compatible)
# Buckets: assets-public (public_read), assets-private
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Auth (generate the secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Optional on Vercel: both fall back to the project's production domain.
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# First admin account (used by bun run db:seed)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare Turnstile ("saya bukan robot") on the contact form.
# The site key of the Ryuartistry widget is built in (components/site/turnstile.tsx); set this only to override it.
# Local testing: 1x00000000000000000000AA (site) / 1x0000000000000000000000000000000AA (secret) always pass.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key from dash.cloudflare.com -> Turnstile -> the widget -> Settings. Checks are enforced only when set.
TURNSTILE_SECRET_KEY=
# Optional, comma separated. Hostnames a token may come from; defaults to the production domain.
# Add preview or custom domains here (and to the widget's hostnames). Never localhost in production.
TURNSTILE_HOSTNAMES=
